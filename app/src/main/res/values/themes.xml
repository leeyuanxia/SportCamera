<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 基础主题（Compose 会覆盖全部 UI，此主题仅用于 Activity 窗口配置） -->
    <style name="Theme.SportCamera" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- 全屏主题：透明状态栏和导航栏，配合 enableEdgeToEdge() 使用 -->
    <!-- 注意：不使用 windowFullscreen=true，它会隐藏状态栏导致 statusBarsPadding() 无效 -->
    <style name="Theme.SportCamera.Fullscreen" parent="Theme.SportCamera">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
</resources>